{
  "name": "paypact-functions",
  "description": "Firebase Cloud Functions for Paypact",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node --test test/*.test.js",
    "test:it": "firebase emulators:exec --only auth,firestore,functions,storage --project demo-paypact --config ../firebase.json \"node --test --test-concurrency=1 it/*.test.js\""
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.1"
  },
  "private": true
}
